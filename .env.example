# Google Sheets API 인증 정보 (서비스 계정 JSON 키 파일 경로)
GOOGLE_APPLICATION_CREDENTIALS=credentials/service_account.json

# 대상 Google Sheets 파일명 또는 ID (둘 중 하나만 채워도 됨, ID 우선 사용)
GOOGLE_SHEETS_NAME=Marketing Intelligence DB
GOOGLE_SHEETS_ID=

# 로그 레벨: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# 분류 결과를 사람이 정성평가하는 별도 스프레드시트 ID
CLASSIFICATION_REVIEW_SHEET_ID=

# LLM(Gemini) 기반 분류기용 API 키 (classify_content_llm.py)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
